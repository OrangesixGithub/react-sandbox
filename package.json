{
  "name": "orangesix-react-sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:package": "vite --mode package",
    "build": "tsc --noEmit && vite build",
    "build:package": "tsc --noEmit --project tsconfig.package.json && vite build --mode package",
    "lint": "eslint src vite.config.ts",
    "lint:fix": "eslint src vite.config.ts --fix"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "primereact": "10.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-perfectionist": "^5.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
