{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@orangesix/react/editor": ["../react/dist/editor", "../react/src/editor"],
      "@orangesix/react/autocomplete": ["../react/dist/autocomplete", "../react/src/autocomplete"],
      "@assets/*": ["./assets/*"],
      "@orangesix/react/textarea": ["../react/dist/textarea", "../react/src/textarea"],
      "@orangesix/react/multiselect": ["../react/dist/multiselect", "../react/src/multiselect"],
      "@orangesix/react/checkbox": ["../react/dist/checkbox", "../react/src/checkbox"],
      "@orangesix/react/switch": ["../react/dist/switch", "../react/src/switch"],
      "@orangesix/react/radio": ["../react/dist/radio", "../react/src/radio"],
      "@orangesix/react/input": ["../react/dist/input", "../react/src/input"],
      "@orangesix/react/*": ["../react/dist/*"]
    }
  }
}
